# Copy to .env and fill in. Never commit .env.

# ── Server ────────────────────────────────────────────────────────────────
SERVER_PORT=8787
# Bind to loopback. Put a private network in front rather than opening a port.
BIND_ADDR=127.0.0.1
DATA_DIR=./server/data

# ── Dashboard auth ────────────────────────────────────────────────────────
# Required. Use a long passphrase, not a PIN: this gates every route.
DASHBOARD_PASSCODE=change-me-to-something-long

# ── Model providers ───────────────────────────────────────────────────────
# Primary: a headless CLI provider on PATH. Falls back to Ollama on any error.
CLAUDE_BIN=claude
CLAUDE_MODEL=sonnet
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
